  "helpTagline": {
    "message": "User guide & Privacy"
  },
  "helpPrivacyHeader": {
    "message": "100% Local Privacy"
  },
  "helpPrivacyText": {
    "message": "Scionos Capture runs entirely in your browser. No screenshot, metadata, or text is transmitted to an external server. Zero accounts, zero tracking, zero network dependencies."
  },
  "helpModesHeader": {
    "message": "Capture Modes"
  },
  "helpModeFull": {
    "message": "Full page: automatically scrolls and stitches the entire document, even on very tall pages."
  },
  "helpModeVisible": {
    "message": "Visible area: instantly captures what is currently on screen without scrolling."
  },
  "helpModeZone": {
    "message": "Selected zone: drag a rectangle with the mouse. Reach screen edges to trigger continuous auto-scroll."
  },
  "helpModeScrolling": {
    "message": "Scrolling zone: click two opposite corners while scrolling to target a precise internal container."
  },
  "helpEditorHeader": {
    "message": "Editing & Export Formats"
  },
  "helpEditorText": {
    "message": "Annotate with arrows, text, step badges, or shapes. Conceal sensitive data using solid masking (blur is strictly visual). Export as high-fidelity PNG, searchable PDF with clickable links, or standalone interactive HTML."
  },
